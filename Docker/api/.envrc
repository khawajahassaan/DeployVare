# .NET API Environment Variables
# Database Configuration
DB_HOST=db
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=DeployVare

# JWT Configuration
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLongForHS256!
JWT_ISSUER=DeployVareAPI
JWT_AUDIENCE=DeployVareClient
JWT_EXPIRATION_MINUTES=480

# Encryption Configuration
ENCRYPTION_KEY=32CharacterLongEncryptionKey12

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_PATH=wwwroot/uploads
BACKUP_PATH=wwwroot/backups

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# Logging
LOG_LEVEL=Information
