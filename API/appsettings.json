{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeployVareDb": "Server=localhost;Database=DeployVare;Integrated Security=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForHS256!",
    "Issuer": "DeployVareAPI",
    "Audience": "DeployVareClient",
    "ExpirationMinutes": 480
  },
  "EncryptionSettings": {
    "EncryptionKey": "32CharacterLongEncryptionKey12"
  },
  "FileUploadSettings": {
    "MaxFileSizeMB": 50,
    "UploadPath": "wwwroot/uploads",
    "BackupPath": "wwwroot/backups"
  },
  "AzureDevOps": {
    "BaseUrl": "https://dev.azure.com",
    "ApiVersion": "7.1",
    "RequestTimeoutSeconds": 30,
    "DownloadTimeoutMinutes": 30,
    "MaxArtifactSizeMB": 1024,
    "MaxBuildsToInspect": 20
  },
  "ServerSetup": {
    "InstallersPath": "../Installers",
    "RemoteInstallersPath": "C:\\DeployVare\\Installers",
    "RequiredDotNetMajorVersion": 10,
    "MinimumSdkMajorVersion": 8,
    "RequiredRedisMajorVersion": 8,
    "InstallTimeoutMinutes": 30,
    "InstallerPatterns": {
      "HostingBundle": "dotnet-hosting-*-win.exe",
      "DotNetSdk": "dotnet-sdk-*-win-x64.exe",
      "Redis": "Memurai*.msi",
      "UrlRewrite": "rewrite_amd64*.msi",
      "SqlServer": "SQL*SSEI*Expr*.exe;SQLEXPR_x64*.exe"
    }
  },
  "BackblazeB2": {
    "Enabled": false,
    "KeyId": "",
    "ApplicationKey": "",
    "BucketName": "",
    "Endpoint": "",
    "Region": ""
  }
}
